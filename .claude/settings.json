{
  "disableAllHooks": false,
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(*)",
      "WebSearch",
      "WebFetch(domain:shopify.dev)",
      "WebFetch(domain:help.shopify.com)"
    ],
    "deny": [
      "Bash(shopify theme push*--live*)",
      "Bash(shopify theme push*--allow-live*)",
      "Bash(shopify theme push*--publish*)",
      "Bash(shopify theme publish*)",
      "Bash(shopify theme delete*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.shopify/**)"
    ],
    "ask": [
      "Bash(shopify theme push*)",
      "Bash(shopify theme pull*)",
      "Bash(shopify theme share*)",
      "Bash(shopify theme rename*)",
      "Bash(shopify theme duplicate*)",
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -qE '(^|[;&|[:space:]])git[[:space:]]+commit([[:space:]]|$)' && { cd \"${CLAUDE_PROJECT_DIR:-.}\" && git push 2>&1 | tail -3; } || true",
            "timeout": 60,
            "statusMessage": "Pushing to origin..."
          }
        ]
      }
    ]
  }
}
