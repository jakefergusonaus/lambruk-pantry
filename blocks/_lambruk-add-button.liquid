

{% assign product = closest.product %}

{% if product != blank and product.available and settings.quick_add %}
  <div class="lambruk-add-button">
    {% render 'quick-add', product: product, section_id: section.id %}
  </div>
{% endif %}

{% stylesheet %}
  /*
    Repositions Horizon's native quick-add from a hover-revealed circular
    overlay on the card image into a persistent, always-visible button in
    the price row. The quick-add snippet itself (variant resolution,
    availability, the Add/Choose branch, cart submission) is untouched —
    only its container's positioning and the button's own visual styling
    are overridden here. See ARCHITECTURE.md's upgrade log for the design
    spec this was measured against.
  */
  .lambruk-add-button {
    display: inline-flex;
  }

  .lambruk-add-button .quick-add {
    display: inline-flex;
    position: static;
    inset: unset;
    pointer-events: auto;
    z-index: auto;
  }

  .lambruk-add-button .quick-add__button {
    display: flex !important;
    opacity: 1 !important;
    position: static;
    align-items: center;
    justify-content: center;
    gap: var(--gap-2xs);
    width: auto;
    max-inline-size: none;
    min-inline-size: 0;
    height: 36px;
    padding: 0 16px;
    border-radius: 6px;
    border: 1px solid #D4BA9C;
    background: transparent;
    color: #131A3E;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
    overflow: visible;
    backdrop-filter: none;
    transition-property: background-color, border-color;
  }

  .lambruk-add-button .add-to-cart-icon {
    display: none;
  }

  .lambruk-add-button .quick-add__button:is(:hover, :focus-visible) {
    width: auto;
    padding-inline-end: 16px;
    background: #EFE9E1;
    border-color: #D4BA9C;
  }

  /*
    Sale-price collision fix. The price+button row is only ~123px wide on a
    2-up mobile grid card; a sale price (current + struck-through compare-at,
    both rendered by snippets/price.liquid as siblings inside one
    [ref="priceContainer"]) doesn't fit next to the button at that width.
    flex-shrink/flex-basis on product-price were tried first and silently
    ignored — something in the existing layout-panel-flex system keeps
    resolving its flex-basis from content regardless (not fully root-caused;
    max-width is the lever that actually works, confirmed live). The sale
    price itself is protected (flex-shrink: 0) and never truncates; only the
    secondary struck-through compare-at price shrinks, then disappears
    entirely rather than truncating mid-digit — confirmed live this reads as
    "$17.00 [Add]" on a 375px 2-up card, not a garbled cut-off number, and
    both prices show in full on desktop where there's room (compare-at
    measured at full 53.98px width, unclipped). No real sale product exists
    in the catalog to verify this against — simulated via injected markup
    matching snippets/price.liquid's actual sale-price output exactly.
  */
  .group-block-content:has(> .lambruk-add-button) product-price {
    max-width: calc(100% - 74px);
    overflow: hidden;
  }

  .group-block-content:has(> .lambruk-add-button) product-price [ref='priceContainer'] {
    display: flex;
    align-items: baseline;
    gap: 4px;
    min-width: 0;
  }

  .group-block-content:has(> .lambruk-add-button) product-price [ref='priceContainer'] .price {
    flex-shrink: 0;
  }

  .group-block-content:has(> .lambruk-add-button) product-price [ref='priceContainer'] .compare-at-price {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /*
    Suppresses Horizon's native hover-pill quick-add (still rendered by the
    unmodified _product-card-gallery block on the card's image) wherever
    this button is present. :has() scopes this to only the four templates
    that include _lambruk-add-button — the homepage Top Sellers rail and
    product-page recommendations never render this block, so their native
    hover pill is untouched. :has() is already used extensively elsewhere
    in Horizon (assets/base.css, etc.), confirmed safe for this project's
    browser support baseline.
  */
  product-card:has(.lambruk-add-button) .card-gallery .quick-add {
    display: none !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Add button (price row)",
  "tag": null,
  "settings": []
}
{% endschema %}
