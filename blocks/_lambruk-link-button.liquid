

{%- doc -%}
  Generic external/PDF link CTA with new-tab accessibility parity.

  _lambruk-view-menu-button intentionally hardcodes one sitewide URL
  (settings.lambruk_cafe_menu_url) and always says "View menu" — this
  block is for every *other* case that needs an editable per-instance
  link opening in a new tab (e.g. a second, different PDF) without
  losing the same "(opens in a new window)" warning for screen reader
  users that block already carries. Renders nothing if the link is
  blank, same principle as not shipping a button with nowhere to send
  people.
{%- enddoc -%}

{% if block.settings.link != blank %}
  {% render 'button-custom-styles', block_settings: block.settings, block_id: block.id %}
  <a
    href="{{ block.settings.link }}"
    class="
      size-style
      {{ block.settings.style_class }}
      {{ block.settings.style_class }}--{{ block.id }}
    "
    style="{% render 'size-style', settings: block.settings %}"
    {%- if block.settings.open_in_new_tab %}
      target="_blank"
      rel="noopener"
    {%- endif %}
    {{ block.shopify_attributes }}
  >
    {{ block.settings.label }}
    {%- if block.settings.open_in_new_tab %}
      <span class="visually-hidden"> {{ 'accessibility.new_window' | t }}</span>
    {%- endif %}
  </a>
{% endif %}

{% schema %}
{
  "name": "Link button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": true
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        { "value": "button", "label": "t:options.primary" },
        { "value": "button-secondary", "label": "t:options.secondary" },
        { "value": "button-unstyled", "label": "t:options.link" },
        { "value": "button-custom", "label": "t:options.custom" }
      ],
      "default": "button-secondary"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "#00000000",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "#131A3E",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "#A07037",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "link_text_color",
      "label": "t:settings.link_text_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.style_class == 'button-unstyled' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ]
}
{% endschema %}
