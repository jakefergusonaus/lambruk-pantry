

{%- doc -%}
  Sitewide "View menu" CTA. Reads its destination from a single theme
  setting (settings.lambruk_cafe_menu_url) rather than a per-instance
  link, so every instance updates from one edit when the client
  re-uploads the menu. Renders nothing at all if that setting is blank —
  same principle as not shipping a button with nowhere to send people.

  Label and destination are intentionally not block-level settings: this
  block always reads the one stored URL and always says "View menu".
  Colour and width stay editable, matching every other button on the
  site, since those are legitimate per-instance style choices.
{%- enddoc -%}

{% liquid
  assign menu_url = settings.lambruk_cafe_menu_url
%}

{% if menu_url != blank %}
  {% render 'button-custom-styles', block_settings: block.settings, block_id: block.id %}
  <a
    href="{{ menu_url }}"
    target="_blank"
    rel="noopener"
    class="
      size-style
      {{ block.settings.style_class }}
      {{ block.settings.style_class }}--{{ block.id }}
      lambruk-view-menu-button
    "
    style="{% render 'size-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.label }}
    <span class="visually-hidden"> {{ 'accessibility.new_window' | t }}</span>
  </a>

  {%- comment -%}
    Optional mobile colour override — used only where the design specifies a
    different variant per breakpoint (the Cafe hero: secondary/cream on
    desktop, primary/navy on mobile). Blank on every other instance, so this
    emits nothing for them. block.id has an unpredictable per-section prefix
    (confirmed live, e.g. "AR3g...__book_table", not the literal JSON key),
    so this has to be generated here — where block.id is actually known —
    rather than by a separate sibling custom-liquid block guessing at it.
    !important: targets the exact same selector button-custom-styles.liquid
    already writes, same specificity; kept explicit rather than trusting
    source order alone, after this project's own history of specificity
    ties resolving unexpectedly (see ARCHITECTURE.md §43, §45).
  {%- endcomment -%}
  {% if block.settings.mobile_custom_button_background != blank
    or block.settings.mobile_custom_button_text != blank
    or block.settings.mobile_custom_button_border != blank
  %}
    {% style %}
      @media screen and (max-width: 749px) {
        .{{ block.settings.style_class }}--{{ block.id }} {
          --button-background-color: rgb({{ block.settings.mobile_custom_button_background.rgba }}) !important;
          --button-color: rgb({{ block.settings.mobile_custom_button_text.rgba }}) !important;
          --button-border-color: rgb({{ block.settings.mobile_custom_button_border.rgba }}) !important;
        }
      }
    {% endstyle %}
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "View menu button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "View menu"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        { "value": "button", "label": "t:options.primary" },
        { "value": "button-secondary", "label": "t:options.secondary" },
        { "value": "button-unstyled", "label": "t:options.link" },
        { "value": "button-custom", "label": "t:options.custom" }
      ],
      "default": "button-custom"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "#00000000",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "#131A3E",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "#D4BA9C",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "link_text_color",
      "label": "t:settings.link_text_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.style_class == 'button-unstyled' }}"
    },
    {
      "type": "header",
      "content": "Mobile colour override (optional)",
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "paragraph",
      "content": "Leave all three blank to use the same colours as desktop. Set all three to switch to a different variant below 750px — used on the Cafe hero, where the design specifies primary/navy on mobile against secondary/cream on desktop.",
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "mobile_custom_button_background",
      "label": "Background (mobile)",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "mobile_custom_button_text",
      "label": "Text (mobile)",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "mobile_custom_button_border",
      "label": "Border (mobile)",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:options.fit_content" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ]
}
{% endschema %}
