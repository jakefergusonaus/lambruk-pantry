{%- doc -%}
  Renders a centred quote on a solid background — validates the
  background_color + contrast-override + explicit text_color pattern from
  ARCHITECTURE.md §2 before it's extended to other surfaces.

  Two rendering modes, chosen by whether `quote_part_1` is set:

  - Segmented (quote_part_1 present): up to 3 gold illustrations sit
    inline within a flowing sentence, glued to the words around them —
    matching the design's "Made with real fruit [icon] Australian
    ingredients [icon] ... [icon]" shape (ARCHITECTURE.md §193, closed
    for Promise and Why Lambruk both). `quote_part_1`-`_4` are the
    up-to-four text fragments around the up-to-three illustrations; any
    of `illustration_1/2/3` left blank simply skips that image and runs
    the two segments either side together — this is how Why Lambruk's
    two illustrations fit the same three-slot shape as Promise's three:
    illustration_1 (jar), illustration_2 left blank, illustration_3
    (peach). Segments are `richtext`, not plain `text`, so Why Lambruk's
    `<em>less sugar</em>` works without a further schema change;
    richtext always wraps its own content in a block-level `<p>`, so
    `.quote-panel__quote p { display: inline }` below is what actually
    keeps the segments flowing inline rather than stacking.

    Illustration margins are NOT keyed to which numbered slot an image
    sits in — Promise's own shape (symmetric first icon, tight second
    and third) made that look like the rule at first, but Why Lambruk's
    shape is the mirror of it (tight first icon, symmetric second), so
    slot position was a coincidence, not the actual rule. The real rule,
    confirmed against both instances: 14px on any side facing a word,
    6px on any side immediately followed by a `<br>` or where nothing
    follows at all. Expressed in the stylesheet via `:has(+ br)` and
    `:last-child` rather than per-slot classes — verified to reproduce
    Promise's exact original margins unchanged.

    `hide_break_on_mobile` (default off) exists because Promise's forced
    `<br>` sits at the same relative position on both breakpoints, but
    Why Lambruk's mobile source has no forced break at all — one flowing
    paragraph, natural wrapping only. Off by default so Promise needs no
    setting change; Why Lambruk turns it on.

  - Legacy (quote_part_1 blank): the original single `quote` richtext
    field plus one optional trailing `illustration`, unchanged — every
    other quote-panel instance keeps rendering exactly as before.
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, border_color: block_settings.accent_color, section_id: block.id
  assign is_segmented = false
  if block_settings.quote_part_1 != blank
    assign is_segmented = true
  endif
%}

<div
  class="quote-panel color-custom-{{ block.id }} spacing-style"
  style="
    {% render 'spacing-padding-surface', settings: block_settings %}
    width: 100%;
  "
  {{ block.shopify_attributes }}
>
  <div class="quote-panel__content" style="text-align: center; max-width: {% if is_segmented %}62.5rem{% else %}46rem{% endif %}; margin-inline: auto;">
    {%- if block_settings.eyebrow != blank -%}
      <p
        class="quote-panel__eyebrow"
        style="
          margin: 0 0 1rem;
          font-size: var(--font-size--2xs);
          font-weight: 500;
          letter-spacing: 0.22em;
          text-transform: uppercase;
          color: var(--color-border);
        "
      >
        {{ block_settings.eyebrow }}
      </p>
    {%- endif -%}

    {%- if is_segmented -%}
      <div class="quote-panel__quote quote-panel__quote--segmented h3 text-display-3" style="margin: 0;">
        {{- block_settings.quote_part_1 -}}
        {%- if block_settings.illustration_1 != blank -%}
          &nbsp;{{
            block_settings.illustration_1
            | image_url: width: 200
            | image_tag: widths: '104, 152', class: 'quote-panel__illustration', alt: '', loading: 'lazy'
          }}
        {%- endif -%}
        {%- if block_settings.quote_part_2 != blank %} {{ block_settings.quote_part_2 }}{% endif -%}
        {%- if block_settings.illustration_2 != blank -%}
          &nbsp;{{
            block_settings.illustration_2
            | image_url: width: 200
            | image_tag: widths: '104, 152', class: 'quote-panel__illustration', alt: '', loading: 'lazy'
          }}
        {%- endif -%}
        <br class="quote-panel__break{% if block_settings.hide_break_on_mobile %} quote-panel__break--hide-mobile{% endif %}">
        {%- if block_settings.quote_part_3 != blank -%}{{ block_settings.quote_part_3 }}{%- endif -%}
        {%- if block_settings.illustration_3 != blank -%}
          &nbsp;{{
            block_settings.illustration_3
            | image_url: width: 200
            | image_tag: widths: '104, 152', class: 'quote-panel__illustration', alt: '', loading: 'lazy'
          }}
        {%- endif -%}
        {%- if block_settings.quote_part_4 != blank %} {{ block_settings.quote_part_4 }}{% endif -%}
      </div>
    {%- elsif block_settings.quote != blank -%}
      <div class="quote-panel__quote h3 text-display-3" style="margin: 0;">
        {{ block_settings.quote }}
      </div>
    {%- endif -%}

    {%- if is_segmented == false and block_settings.illustration != blank -%}
      {{
        block_settings.illustration
        | image_url: width: 200
        | image_tag: widths: '104, 152', class: 'quote-panel__illustration', alt: '', loading: 'lazy'
      }}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .quote-panel__illustration {
    display: inline-block;
    height: clamp(52px, 40.988px + 2.824vw, 76px);
    width: auto;
    vertical-align: middle;
    margin-block-start: 1.5rem;
  }

  /* Font-size/line-height for the base (non-segmented) case come from
     `.text-display-3` itself — hardened in assets/lambruk-tokens.css
     against Horizon's `.h3.h3` (see the comment there) rather than
     re-fixed per-instance here. Segmented mode still needs its own
     line-height override below: this quote is a wrapping, multi-line
     sentence, not a short heading, and the source gives it 1.45/1.5
     rather than Display 3's usual 1.08. */
  .quote-panel__quote.quote-panel__quote--segmented {
    line-height: 1.5;
  }

  .quote-panel__quote--segmented p {
    display: inline;
    margin: 0;
  }

  .quote-panel__quote--segmented .quote-panel__illustration {
    margin-block-start: 0;
    margin-inline: 6px;
  }

  /* Not keyed to slot number — see the doc comment above. 14px on any
     side facing a word (the default below), dropping to 6px only on
     the side immediately before a <br> or where nothing follows at
     all (the two selectors below). Verified to reproduce Promise's
     original per-slot margins unchanged. */
  @media screen and (min-width: 750px) {
    .quote-panel__quote.quote-panel__quote--segmented {
      line-height: 1.45;
    }

    .quote-panel__quote--segmented .quote-panel__illustration {
      margin-inline: 14px;
    }

    .quote-panel__quote--segmented .quote-panel__illustration:has(+ br),
    .quote-panel__quote--segmented .quote-panel__illustration:last-child {
      margin-inline-end: 6px;
    }
  }

  @media screen and (max-width: 749px) {
    .quote-panel__break--hide-mobile {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.quote_panel",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.the_lambruk_promise"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "t:settings.quote",
      "default": "t:html_defaults.crafted_in_small_quantities_less_sugar"
    },
    {
      "type": "image_picker",
      "id": "illustration",
      "label": "t:settings.illustration"
    },
    {
      "type": "header",
      "content": "t:content.quote_segments"
    },
    {
      "type": "paragraph",
      "content": "t:info.quote_segments"
    },
    {
      "type": "richtext",
      "id": "quote_part_1",
      "label": "t:settings.quote_part_1"
    },
    {
      "type": "image_picker",
      "id": "illustration_1",
      "label": "t:settings.illustration_1"
    },
    {
      "type": "richtext",
      "id": "quote_part_2",
      "label": "t:settings.quote_part_2"
    },
    {
      "type": "image_picker",
      "id": "illustration_2",
      "label": "t:settings.illustration_2"
    },
    {
      "type": "richtext",
      "id": "quote_part_3",
      "label": "t:settings.quote_part_3"
    },
    {
      "type": "image_picker",
      "id": "illustration_3",
      "label": "t:settings.illustration_3"
    },
    {
      "type": "richtext",
      "id": "quote_part_4",
      "label": "t:settings.quote_part_4"
    },
    {
      "type": "checkbox",
      "id": "hide_break_on_mobile",
      "label": "t:settings.hide_break_on_mobile",
      "info": "t:info.hide_break_on_mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#131A3E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#F7F5F2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "#C6A06C"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.quote_panel",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
