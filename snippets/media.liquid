{%- doc -%}
  Renders media block contents (used in _media and _media-without-appearance blocks)

  @param {object} [block] - The block object
  @param {boolean} [unset_image_tag] - if true, ignores the image focal point in the image
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign show_image = false
  assign show_video = false

  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, section_id: block.id
  endif

  if block_settings.media_type == 'image'
    assign show_image = true
  endif

  if block_settings.media_type == 'video'
    assign show_video = true
  endif

  # Responsive sizing for the real <img> path only (see snippets/image.liquid).
  # media-with-content is the only current caller of this snippet, and every live
  # instance uses media_width: "medium" -- a flat 50/50 split of the page's central
  # column (sections/media-with-content.liquid's own .media-with-content--medium
  # rule), not the 7:5 "wide" default. Confirmed live at 1280px before writing this
  # (600px/600px either side, not 700/500) rather than assumed from the CSS alone.
  # Desktop margin is 40px (assets/base.css default); mobile margin is this
  # project's own 20px override (assets/lambruk-tokens.css, @media max-width:749px),
  # not Horizon's native 16px -- also confirmed live before use.
  #   desktop (>=750px): min(720px, calc(50vw - 40px))
  #     -- 720px = half of the narrow page-content-width's 1440px cap, engaged
  #     once viewport >= 1520px; 50vw - 40px below that (half of 100vw - 2*40px)
  #   mobile (<750px): calc(100vw - 40px) -- full-bleed within the 20px gutter
  # "medium" is the only media_width value any section actually uses today; a
  # future narrow/wide instance falls through to this same formula rather than
  # erroring, which is a safe-ish default (narrow's media column is never wider
  # than half the central column, wide's is never much more) but not exact for
  # either -- re-derive properly against sections/media-with-content.liquid's
  # own narrow/wide grid rules if one is ever actually used with a real photo.
  assign image_sizes = '(min-width: 750px) min(720px, calc(50vw - 40px)), calc(100vw - 40px)'

  # Rungs near each real requirement (375px viewport @3x ~= 1005px; 1280px
  # desktop box @2x = 1200px; the medium-split cap @2x = 1440px) rather than
  # a sparse list that forces a big jump. No gap between consecutive rungs
  # exceeds ~1.5x.
  assign image_widths = '335, 500, 670, 800, 1000, 1200, 1440'
%}

<div
  class="
    media-block
    spacing-style
    {% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}
    {% if show_image and block_settings.image_position == 'contain' or show_video and block_settings.video_position == 'contain' %}
      media-block--contain
    {% endif %}
  "
  style="
    {% render 'border-override', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --image-position: {{ block_settings.image_position }};
    --video-position: {{ block_settings.video_position }};
  "
  {{ block.shopify_attributes }}
>
  {%- if show_image -%}
    {% capture image_tag %}
      {% if block_settings.image != blank %}
        {% render 'image',
          image: block_settings.image,
          class: 'media-block__media border-style',
          unset_image_tag: unset_image_tag,
          widths: image_widths,
          sizes: image_sizes
        %}
      {% else %}
        <div class="media-block__media border-style">
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'media-block__placeholder' }}
        </div>
      {% endif %}
    {% endcapture %}

    {% if block_settings.link != blank %}
      <a
        href="{{ block_settings.link }}"
        class="media-block__media-link"
      >
        {{ image_tag }}
      </a>
    {% else %}
      {{ image_tag }}
    {% endif %}
  {%- elsif show_video -%}
    {% render 'video',
      video: block_settings.video,
      video_autoplay: block_settings.video_autoplay,
      video_loop: block_settings.video_loop,
      video_class: 'media-block__media media-block__media--video border-style'
    %}
  {%- else -%}
    <div class="media-block__media border-style">
      {{ 'hero-apparel-3' | placeholder_svg_tag }}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .media-block {
    overflow: hidden;
    position: relative;
    border-radius: var(--radius-lg);

    @media screen and (min-width: 750px) {
      min-height: var(--media-height);
    }
  }

  .media-block__media {
    height: var(--media-height-mobile, auto);
    object-fit: var(--image-position, 'cover');
    object-position: center center;
    width: 100%;

    @media screen and (min-width: 750px) {
      height: 100%;
      position: absolute;
    }
  }

  deferred-media[class].media-block__media
    :is(.deferred-media__poster-button img, .deferred-media__poster-button ~ video) {
    object-fit: var(--video-position, 'cover');
  }

  /* This is to support corner radius on video and align the video to the center of the block */
  .media-block__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  .media-block__media--video {
    display: flex;
    align-items: center;
    justify-content: center;

    @media screen and (max-width: 749px) {
      --media-height-mobile: auto;
    }
  }
{% endstylesheet %}
