                "corner_radius": 0,
                "padding-block-start": 16,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "body_2": {
              "type": "text",
              "settings": {
                "text": "<p>Every recipe is still tested in the same way: cooked, tasted, adjusted, and only released when it holds up beside the version her family remembers.</p>",
