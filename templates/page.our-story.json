            "body_1": {
              "type": "text",
              "settings": {
                "text": "<p>Paige Brierley started Lambruk Pantry as a passionate home cook, preserving the family recipes she had grown up with. What began as jars for friends and markets became a small-batch production kitchen supplying country stores and hospitality venues across the region.</p>",
                "width": "100%",
                "max_width": "narrow",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
